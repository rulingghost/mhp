# ==========================================
# MHP Web Sitesi & Yönetim Paneli Yapılandırması
# ==========================================

# Sunucu Portu (Yerel Geliştirme İçin)
PORT=3000

# Yönetim Paneli Giriş Şifresi
ADMIN_PASSWORD=admin123

# Oturum İmzası (Gizli Anahtar)
SESSION_SECRET=mhp_admin_panel_secure_secret_2026_uygar_ozturk

# ==========================================
# VERCEL KALICILIK İÇİN VERİTABANI BAĞLANTISI
# (Aşağıdaki 2 SEÇENEKTEN BİRİNİ DOLDURMANIZ YETERLİDİR)
# ==========================================

# SEÇENEK A: Vercel KV / Upstash Redis (ÖNERİLEN - 1 TIKLA KURULUM)
# Vercel Dashboard -> Storage -> Create KV (Upstash) -> Projeye Bağla
# Vercel bu değişkenleri otomatik olarak tanımlar:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# SEÇENEK B: Supabase (Alternatif)
# Supabase Dashboard -> Project Settings -> API
# schema.sql dosyasını SQL Editor'de çalıştırdıktan sonra bu bilgileri girin:
SUPABASE_URL=
SUPABASE_KEY=
